{
  "name": "adcheck",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "tsc -b && oxlint && vite build",
    "analyze": "node scripts/analyze-prompts.mjs",
    "deploy": "vite build && npx --yes vercel@latest deploy dist --prod --yes --project adcheck-vibethon --create-if-missing",
    "deploy:temp": "vite build && npx --yes vercel@latest deploy dist --prod --temporary --yes"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
